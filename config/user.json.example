{
  "_comment": "OkHuman 用户配置模板：复制为 config/user.json 后按需修改。三条约定 —— (1) user.json 是最小补丁，只保留你要覆盖的键，未写的走 config/default.json 的出厂默认；(2) 本文件必须是严格合法的 JSON，不支持 // 注释（loader 用 encoding/json），说明一律写进这种字符串字段；(3) 优先级：内置默认值 < default.json < user.json < 环境变量(OKHUMAN_PORT / OKHUMAN_LLM_BASE_URL / OKHUMAN_LLM_MODEL / OKHUMAN_DATA_DIR)。不要把 data.dir 写成空串，数据目录建议用 OKHUMAN_DATA_DIR 或保留默认 $HOME/.okhuman-<port>。",
  "server": { "host": "127.0.0.1", "port": 8451 },
  "llm": {
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o",
    "api_key": "sk-your-api-key-here",
    "timeout_ms": 300000
  },
  "system_prompt": { "dir": "prompts" },
  "context": {
    "max_tokens": 150000,
    "keep_recent_chars": 60000,
    "hard_trunc_chars": 150000,
    "stream_idle_ms": 90000,
    "chars_per_token": 1.5
  },
  "tools": {
    "_comment": "ipython_python 启用 ipython 元工具：留空 = 不注册该工具；auto = 自动探测第一个装了 IPython 的解释器；或填解释器绝对路径。依赖只需 pip install ipython（不需要 ipykernel / pyzmq）。",
    "fg_timeout_ms": 30000,
    "result_limit": 50000,
    "timeout_ms": 600000,
    "max_tool_rounds": 200,
    "ipython_python": ""
  },
  "doom": { "warn_after": 3 }
}
